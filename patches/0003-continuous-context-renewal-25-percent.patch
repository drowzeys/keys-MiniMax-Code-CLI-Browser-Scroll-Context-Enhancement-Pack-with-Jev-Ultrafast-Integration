diff --git a/packages/agent-modules/context-manager/test/continuous-trigger.test.ts b/packages/agent-modules/context-manager/test/continuous-trigger.test.ts
new file mode 100644
index 0000000..4b21c6b
--- /dev/null
+++ b/packages/agent-modules/context-manager/test/continuous-trigger.test.ts
@@ -0,0 +1,40 @@
+import { describe, expect, it } from 'vitest';
+import { computeCompactionTriggerAt } from '../src/settings.js';
+import { resolveCompactionTokenBudget } from '../src/provider-budget.js';
+
+describe('continuous context renewal', () => {
+  it('starts compaction after 25% of the context is used', () => {
+    expect(
+      computeCompactionTriggerAt({
+        modelId: 'any-model',
+        contextWindow: 128_000,
+        perTurnMaxTokens: 8_192,
+        reserveTokens: 16_384,
+        safetyMarginTokens: 2_048,
+      }),
+    ).toBe(32_000);
+  });
+
+  it('keeps the same 25% trigger for every renewal cycle', () => {
+    expect(
+      resolveCompactionTokenBudget({
+        contextWindow: 128_000,
+        configuredMaxOutputTokens: 8_192,
+      }),
+    ).toMatchObject({
+      automaticTriggerAt: 32_000,
+      providerInputLimit: 111_616,
+    });
+  });
+
+  it('clamps tiny windows to a usable one-token trigger', () => {
+    expect(
+      computeCompactionTriggerAt({
+        contextWindow: 2,
+        perTurnMaxTokens: 1,
+        reserveTokens: 1,
+        safetyMarginTokens: 1,
+      }),
+    ).toBe(1);
+  });
+});
